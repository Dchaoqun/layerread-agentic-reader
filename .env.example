# LayerRead Portfolio Edition
LAYERREAD_APP_MODE=portfolio

# Optional. The default is data/layerread.sqlite3.
# LAYERREAD_DB_PATH=data/layerread.sqlite3

# Copy this file to .env, then replace the placeholders with your own
# OpenAI-compatible model configuration. The real .env is ignored by Git.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.provider.example/v1
LLM_MODEL=your_model_name_here

# Set to true only when the configured model accepts OpenAI-compatible image
# input and you allow LayerRead to send article images when analysis is run.
LLM_SUPPORTS_VISION=false

# Optional HTTP(S) proxy used only for model requests.
# LLM_PROXY_URL=http://127.0.0.1:7890
