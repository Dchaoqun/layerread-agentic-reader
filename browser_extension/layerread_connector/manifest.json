{
  "manifest_version": 3,
  "name": "LayerRead Connector",
  "version": "0.4.4",
  "description": "Send the current WeChat article and readable images to an approved LayerRead app with one click.",
  "action": {
    "default_title": "发送当前文章到 LayerRead"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mmbiz.qpic.cn/*",
    "https://mmbiz.qlogo.cn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://mp.weixin.qq.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "config.js",
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "110"
}
